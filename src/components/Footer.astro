<footer
    class="border-t border-gray-200 dark:border-border-dark bg-white dark:bg-background-dark pt-16 pb-8"
>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 gap-8 md:grid-cols-4 lg:grid-cols-5">
            <div class="col-span-2 lg:col-span-2">
                <a
                    href="/"
                    class="flex items-center gap-2 mb-4 hover:opacity-90 transition-opacity"
