                            href="#">Contact</a
                        >
                    </li>
                </ul>
            </div>
            <div>
                <h3
                    class="text-sm font-semibold text-slate-900 dark:text-white mb-4"
                >
                    Legal
                </h3>
                <ul class="space-y-3" role="list">
                    <li>
                        <a
                            class="text-sm text-gray-500 hover:text-primary transition-colors"
