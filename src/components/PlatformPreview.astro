---

---

<section class="py-16 lg:py-24 relative">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div
            class="relative rounded-xl border border-gray-200 dark:border-border-dark bg-white dark:bg-surface-dark shadow-2xl overflow-hidden ring-1 ring-slate-900/10"
        >
            <!-- Fake Browser/App Header -->
            <div
                class="flex items-center gap-2 border-b border-gray-100 dark:border-border-dark bg-gray-50 dark:bg-[#13161c] px-4 py-3"
            >
                <div class="flex gap-1.5">
                    <div class="h-3 w-3 rounded-full bg-red-400"></div>
                    <div class="h-3 w-3 rounded-full bg-yellow-400"></div>
                    <div class="h-3 w-3 rounded-full bg-green-400"></div>
                </div>
                <div
                    class="ml-4 flex h-6 items-center rounded bg-gray-200 dark:bg-border-dark px-3 text-[10px] sm:text-xs text-gray-500 truncate min-w-0"
                >
                    fintechpro.app/dashboard/trade/BTC-USD
                </div>
            </div>
            <!-- Dashboard Content -->
            <div
                class="grid grid-cols-12 h-[500px] lg:h-[600px] divide-x divide-gray-100 dark:divide-border-dark bg-white dark:bg-surface-dark"
            >
                <!-- Left Sidebar (Assets) -->
                <div
                    class="hidden md:block col-span-2 lg:col-span-2 p-4 space-y-4"
                >
                    <div
                        class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2"
                    >
                        Watchlist
                    </div>
                    <div class="space-y-2">
                        <div
                            class="flex justify-between items-center p-2 bg-gray-50 dark:bg-border-dark/50 rounded cursor-pointer border border-transparent dark:border-primary/20"
                        >
                            <span class="font-medium text-sm">BTC</span>
                            <span class="text-sm text-accent-green">+2.4%</span>
                        </div>
                        <div
                            class="flex justify-between items-center p-2 hover:bg-gray-50 dark:hover:bg-border-dark/30 rounded cursor-pointer"
                        >
                            <span class="font-medium text-sm">ETH</span>
                            <span class="text-sm text-accent-red">-1.2%</span>
                        </div>
                        <div
                            class="flex justify-between items-center p-2 hover:bg-gray-50 dark:hover:bg-border-dark/30 rounded cursor-pointer"
                        >
                            <span class="font-medium text-sm">SOL</span>
                            <span class="text-sm text-accent-green">+5.8%</span>
                        </div>
                        <div
                            class="flex justify-between items-center p-2 hover:bg-gray-50 dark:hover:bg-border-dark/30 rounded cursor-pointer"
                        >
                            <span class="font-medium text-sm">AAPL</span>
                            <span class="text-sm text-gray-400">0.0%</span>
                        </div>
                    </div>
                </div>
                <!-- Main Chart Area -->
                <div
                    class="col-span-12 md:col-span-7 lg:col-span-8 flex flex-col relative bg-cover bg-center"
                    style="background-image: linear-gradient(rgba(17, 24, 39, 0.9), rgba(17, 24, 39, 0.95)), url('https://lh3.googleusercontent.com/aida-public/AB6AXuBnzpV18RV8DL1adxNKN2Yj-Z5K4SBVzOBhgt52Lgm4Pg7QqqpbaAzW3u02Xa-m5lxTJ-rVmwb_H4r49t9jcg53ZVtElGUaYu6JSEHBEhysQcKFid-pOxL4BKKdTOxiR-R_dxpwwuzBV5BSpVVJ7A8hwL_ItgfKKSHHc5_v6vsPIYjf9HFm4x6XXnOVeTMjx_NeYaRQn7UWuv3NABh87OCWHhz0ayQqOxn9CKX0eIZKHIOxshEwYF35KJJOpOUuYxRATlW6PEdKR8A');"
                >
                    <!-- Chart Toolbar -->
                    <div
                        class="flex items-center justify-between border-b border-gray-100 dark:border-border-dark p-3 bg-white/5 dark:bg-surface-dark/90 backdrop-blur-sm z-10"
                    >
                        <div class="flex items-center gap-3">
                            <h3 class="font-bold text-lg text-white">
                                BTC/USD
                            </h3>
                            <span
                                class="px-2 py-0.5 rounded text-xs bg-accent-green/20 text-accent-green font-medium"
                                >+2.45%</span
                            >
                        </div>
                        <div class="flex gap-2">
                            <span
                                class="text-xs text-gray-400 px-2 py-1 hover:bg-white/10 rounded cursor-pointer"
                                >1H</span
                            >
                            <span
                                class="text-xs text-white bg-primary px-2 py-1 rounded cursor-pointer"
                                >4H</span
                            >
                            <span
                                class="text-xs text-gray-400 px-2 py-1 hover:bg-white/10 rounded cursor-pointer"
                                >1D</span
                            >
                            <span
                                class="flex items-center justify-center ml-2 notranslate"
                                translate="no"
                            >
                                <span
                                    class="material-symbols-outlined text-gray-400 text-sm cursor-pointer"
                                    >settings</span
                                >
                            </span>
                        </div>
                    </div>
                    <!-- SVG Chart Mockup -->
                    <div class="flex-1 w-full h-full relative p-6">
                        <svg
                            class="w-full h-full"
                            preserveAspectRatio="none"
                            viewBox="0 0 800 400"
                        >
                            <!-- Grid lines -->
                            <line
                                x1="0"
                                y1="100"
                                x2="800"
                                y2="100"
                                stroke="#2a2f3a"
                                stroke-width="1"
                                stroke-dasharray="4"></line>
                            <line
                                x1="0"
                                y1="200"
                                x2="800"
                                y2="200"
                                stroke="#2a2f3a"
                                stroke-width="1"
                                stroke-dasharray="4"></line>
                            <line
                                x1="0"
                                y1="300"
                                x2="800"
                                y2="300"
                                stroke="#2a2f3a"
                                stroke-width="1"
                                stroke-dasharray="4"></line>
                            <!-- Chart Line -->
                            <path
                                d="M0,320 L50,310 L100,340 L150,280 L200,290 L250,250 L300,270 L350,220 L400,240 L450,180 L500,190 L550,150 L600,160 L650,120 L700,130 L750,90 L800,80"
                                fill="none"
                                stroke="#2b6cee"
                                stroke-width="2"
                                class="drop-shadow-[0_0_10px_rgba(43,108,238,0.5)]"
                            ></path>
                            <path
                                d="M0,320 L50,310 L100,340 L150,280 L200,290 L250,250 L300,270 L350,220 L400,240 L450,180 L500,190 L550,150 L600,160 L650,120 L700,130 L750,90 L800,80 V 400 H 0 Z"
                                fill="url(#gradient)"
                                opacity="0.2"></path>
                            <!-- Candlesticks (Mock) -->
                            <rect
                                x="680"
                                y="110"
                                width="8"
                                height="40"
                                fill="#10B981"
                                rx="1"></rect>
                            <line
                                x1="684"
                                y1="100"
                                x2="684"
                                y2="160"
                                stroke="#10B981"
                                stroke-width="1"></line>
                            <rect
                                x="710"
                                y="120"
                                width="8"
                                height="20"
                                fill="#EF4444"
                                rx="1"></rect>
                            <line
                                x1="714"
                                y1="115"
                                x2="714"
                                y2="150"
                                stroke="#EF4444"
                                stroke-width="1"></line>
                            <rect
                                x="740"
                                y="90"
                                width="8"
                                height="50"
                                fill="#10B981"
                                rx="1"></rect>
                            <line
                                x1="744"
                                y1="80"
                                x2="744"
                                y2="150"
                                stroke="#10B981"
                                stroke-width="1"></line>
                            <defs>
                                <linearGradient
                                    id="gradient"
                                    x1="0%"
                                    y1="0%"
                                    x2="0%"
                                    y2="100%"
                                >
                                    <stop
                                        offset="0%"
                                        style="stop-color:#2b6cee;stop-opacity:1"
                                    ></stop>
                                    <stop
                                        offset="100%"
                                        style="stop-color:#2b6cee;stop-opacity:0"
                                    ></stop>
                                </linearGradient>
                            </defs>
                        </svg>
                        <!-- Floating Indicators -->
                        <div
                            class="absolute top-20 left-10 bg-surface-dark/80 backdrop-blur border border-border-dark p-2 rounded shadow-lg"
                        >
                            <div class="text-[10px] text-gray-400 mb-1">
                                MA (50)
                            </div>
                            <div class="text-sm font-mono text-primary">
                                42,850.2
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Right Sidebar (Order Book / Buy Sell) -->
                <div
                    class="hidden md:flex col-span-3 lg:col-span-2 flex-col p-4 bg-gray-50 dark:bg-[#13161c]"
                >
                    <div class="flex-1">
                        <div
                            class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-4"
                        >
                            Order Book
                        </div>
                        <div class="space-y-1 mb-6">
                            <div class="flex justify-between text-xs">
                                <span class="text-accent-red">43,215.5</span>
                                <span class="text-gray-500">0.45</span>
                            </div>
                            <div class="flex justify-between text-xs">
                                <span class="text-accent-red">43,214.0</span>
                                <span class="text-gray-500">1.20</span>
                            </div>
                            <div class="flex justify-between text-xs">
                                <span class="text-accent-red">43,213.5</span>
                                <span class="text-gray-500">0.15</span>
                            </div>
                            <div
                                class="my-2 border-t border-dashed border-gray-700"
                            >
                            </div>
                            <div class="flex justify-between text-xs">
                                <span class="text-accent-green">43,210.5</span>
                                <span class="text-gray-500">2.50</span>
                            </div>
                            <div class="flex justify-between text-xs">
                                <span class="text-accent-green">43,209.0</span>
                                <span class="text-gray-500">0.85</span>
                            </div>
                        </div>
                    </div>
                    <div class="mt-auto space-y-3">
                        <button
                            class="w-full py-2 bg-accent-green hover:bg-emerald-600 text-white text-sm font-bold rounded transition-colors"
                            >Buy BTC</button
                        >
                        <button
                            class="w-full py-2 bg-accent-red hover:bg-red-600 text-white text-sm font-bold rounded transition-colors"
                            >Sell BTC</button
                        >
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
