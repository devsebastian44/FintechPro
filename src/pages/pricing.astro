---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Pricing & Plans - FintechPro">
    <Navbar />
    <main>
        <!-- Hero Section -->
        <section
            class="relative pt-20 pb-12 overflow-hidden bg-background-dark"
        >
            <div
                class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[400px] bg-primary/10 blur-[120px] rounded-full pointer-events-none z-0"
            >
            </div>
            <div class="relative z-10 mx-auto max-w-7xl px-4 text-center">
                <h1 class="text-4xl font-black tracking-tight sm:text-6xl mb-6">
                    Institutional Power, <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-blue-400"
                        >Personal Pricing</span
                    >
                </h1>
                <p class="max-w-2xl mx-auto text-lg text-gray-400 mb-10">
                    Choose the plan that fits your trading style. Unlock
                    advanced analytics, custom indicators, and real-time market
                    insights.
                </p>
                <div class="flex items-center justify-center gap-4 mb-12">
                    <span class="text-sm font-medium text-gray-400"
                        >Monthly</span
                    >
                    <button
                        class="relative inline-flex h-6 w-11 items-center rounded-full bg-border-dark transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-background-dark"
                    >
                        <span
                            class="translate-x-6 inline-block h-4 w-4 transform rounded-full bg-primary transition-transform"
                        ></span>
                    </button>
                    <span
                        class="text-sm font-medium text-white flex items-center gap-2"
                    >
                        Annual Billing
                        <span
                            class="px-2 py-0.5 text-[10px] font-bold bg-accent-green/20 text-accent-green rounded-full border border-accent-green/30"
                            >SAVE 20%</span
                        >
                    </span>
                </div>
            </div>
        </section>

        <!-- Pricing Tiers -->
        <section class="pb-24 bg-background-dark">
            <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                <div
                    class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch"
                >
                    <!-- Basic -->
                    <div class="glass-card p-8 flex flex-col">
                        <div class="mb-8">
                            <h3 class="text-xl font-bold mb-2">Basic</h3>
                            <p class="text-sm text-gray-400 mb-6">
                                Perfect for beginners learning the ropes.
                            </p>
                            <div class="flex items-baseline gap-1">
                                <span class="text-4xl font-bold">$0</span>
                                <span class="text-gray-500 text-sm">/mo</span>
                            </div>
                        </div>
                        <ul class="space-y-4 mb-10 flex-1">
                            <li
                                class="flex items-center gap-3 text-sm text-gray-300"
                            >
                                <span
                                    class="material-symbols-outlined text-accent-green text-lg notranslate"
                                    translate="no">check_circle</span
                                >
                                Real-time Market Data (Delayed)
                            </li>
                            <li
                                class="flex items-center gap-3 text-sm text-gray-300"
                            >
                                <span
                                    class="material-symbols-outlined text-accent-green text-lg notranslate"
                                    translate="no">check_circle</span
                                >
                                3 Watchlists
                            </li>
                            <li
                                class="flex items-center gap-3 text-sm text-gray-300"
                            >
                                <span
                                    class="material-symbols-outlined text-accent-green text-lg notranslate"
                                    translate="no">check_circle</span
                                >
                                Standard Technical Indicators
                            </li>
                            <li
                                class="flex items-center gap-3 text-sm text-gray-400"
                            >
                                <span
                                    class="material-symbols-outlined text-gray-600 text-lg notranslate"
                                    translate="no">cancel</span
                                >
                                No API Access
                            </li>
                        </ul>
                        <button
                            class="w-full py-3 rounded-xl border border-border-dark bg-white/5 font-bold hover:bg-white/10 transition-colors"
                        >
                            Get Started
                        </button>
                    </div>

                    <!-- Pro -->
                    <div
                        class="glass-card pro-highlight p-8 flex flex-col relative md:scale-105 z-10"
                    >
                        <div
                            class="absolute -top-4 left-1/2 -translate-x-1/2 px-4 py-1 bg-primary text-xs font-bold rounded-full text-white tracking-wide shadow-lg shadow-primary/20"
                        >
                            MOST POPULAR
                        </div>
                        <div class="mb-8">
                            <h3 class="text-xl font-bold mb-2">Pro</h3>
                            <p class="text-sm text-gray-400 mb-6">
                                Advanced analytics for serious traders.
                            </p>
                            <div class="flex items-baseline gap-1">
                                <span class="text-4xl font-bold">$49</span>
                                <span class="text-gray-500 text-sm">/mo</span>
                            </div>
                        </div>
                        <ul class="space-y-4 mb-10 flex-1">
                            <li
                                class="flex items-center gap-3 text-sm text-gray-100"
                            >
                                <span
                                    class="material-symbols-outlined text-primary text-lg notranslate"
                                    translate="no">check_circle</span
                                >
                                No-latency Real-time Data
                            </li>
                            <li
                                class="flex items-center gap-3 text-sm text-gray-100"
                            >
                                <span
                                    class="material-symbols-outlined text-primary text-lg notranslate"
                                    translate="no">check_circle</span
                                >
                                Unlimited Watchlists
                            </li>
                            <li
                                class="flex items-center gap-3 text-sm text-gray-100"
                            >
                                <span
                                    class="material-symbols-outlined text-primary text-lg notranslate"
                                    translate="no">check_circle</span
                                >
                                Custom Pine Script Indicators
                            </li>
                            <li
                                class="flex items-center gap-3 text-sm text-gray-100"
                            >
                                <span
                                    class="material-symbols-outlined text-primary text-lg notranslate"
                                    translate="no">check_circle</span
                                >
                                SMS & Webhook Smart Alerts
                            </li>
                            <li
                                class="flex items-center gap-3 text-sm text-gray-100"
                            >
                                <span
                                    class="material-symbols-outlined text-primary text-lg notranslate"
                                    translate="no">check_circle</span
                                >
                                Advanced Backtesting Suite
                            </li>
                        </ul>
                        <button
                            class="w-full py-3 rounded-xl bg-primary text-white font-bold hover:bg-primary-hover shadow-lg shadow-primary/30 transition-all transform hover:scale-[1.02]"
                        >
                            Upgrade to Pro
                        </button>
                    </div>

                    <!-- Institutional -->
                    <div class="glass-card p-8 flex flex-col">
                        <div class="mb-8">
                            <h3 class="text-xl font-bold mb-2">
                                Institutional
                            </h3>
                            <p class="text-sm text-gray-400 mb-6">
                                For firms requiring high-throughput data.
                            </p>
                            <div class="flex items-baseline gap-1">
                                <span class="text-4xl font-bold">$299</span>
                                <span class="text-gray-500 text-sm">/mo</span>
                            </div>
                        </div>
                        <ul class="space-y-4 mb-10 flex-1">
                            <li
                                class="flex items-center gap-3 text-sm text-gray-300"
                            >
                                <span
                                    class="material-symbols-outlined text-accent-green text-lg notranslate"
                                    translate="no">check_circle</span
                                >
                                Full WebSocket API Access
                            </li>
                            <li
                                class="flex items-center gap-3 text-sm text-gray-300"
                            >
                                <span
                                    class="material-symbols-outlined text-accent-green text-lg notranslate"
                                    translate="no">check_circle</span
                                >
                                Dedicated Account Manager
                            </li>
                            <li
                                class="flex items-center gap-3 text-sm text-gray-300"
                            >
                                <span
                                    class="material-symbols-outlined text-accent-green text-lg notranslate"
                                    translate="no">check_circle</span
                                >
                                Custom Branding / White-label
                            </li>
                            <li
                                class="flex items-center gap-3 text-sm text-gray-300"
                            >
                                <span
                                    class="material-symbols-outlined text-accent-green text-lg notranslate"
                                    translate="no">check_circle</span
                                >
                                SLA 99.99% Uptime Guarantee
                            </li>
                            <li
                                class="flex items-center gap-3 text-sm text-gray-300"
                            >
                                <span
                                    class="material-symbols-outlined text-accent-green text-lg notranslate"
                                    translate="no">check_circle</span
                                >
                                On-premise Deployment Options
                            </li>
                        </ul>
                        <button
                            class="w-full py-3 rounded-xl border border-white/20 bg-white/5 font-bold hover:bg-white/10 transition-colors"
                        >
                            Contact Sales
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <section class="py-24 border-t border-border-dark bg-surface-dark/30">
            <div class="mx-auto max-w-4xl px-4">
                <h2 class="text-3xl font-bold text-center mb-16 text-white">
                    Frequently Asked Questions
                </h2>
                <div class="space-y-6">
                    <div
                        class="p-6 rounded-xl bg-surface-dark border border-border-dark"
                    >
                        <h4
                            class="text-lg font-bold mb-3 flex items-center justify-between text-white"
                        >
                            Can I switch plans later?
                            <span
                                class="material-symbols-outlined text-gray-500 notranslate"
                                translate="no">expand_more</span
                            >
                        </h4>
                        <p class="text-gray-400 text-sm">
                            Absolutely. You can upgrade or downgrade your plan
                            at any time. When upgrading, the change is immediate
                            and pro-rated. Downgrades take effect at the end of
                            your current billing cycle.
                        </p>
                    </div>
                    <div
                        class="p-6 rounded-xl bg-surface-dark border border-border-dark"
                    >
                        <h4
                            class="text-lg font-bold mb-3 flex items-center justify-between text-white"
                        >
                            What payment methods do you accept?
                            <span
                                class="material-symbols-outlined text-gray-500 notranslate"
                                translate="no">expand_more</span
                            >
                        </h4>
                        <p class="text-gray-400 text-sm">
                            We accept all major credit cards, PayPal, and also
                            support cryptocurrency payments (BTC, ETH, USDC) for
                            annual Institutional plans.
                        </p>
                    </div>
                    <div
                        class="p-6 rounded-xl bg-surface-dark border border-border-dark"
                    >
                        <h4
                            class="text-lg font-bold mb-3 flex items-center justify-between text-white"
                        >
                            Do you offer a free trial for Pro?
                            <span
                                class="material-symbols-outlined text-gray-500 notranslate"
                                translate="no">expand_more</span
                            >
                        </h4>
                        <p class="text-gray-400 text-sm">
                            Yes! You can try our Pro features free for 14 days.
                            No credit card is required to start your trial
                            during our current public beta period.
                        </p>
                    </div>
                    <div
                        class="p-6 rounded-xl bg-surface-dark border border-border-dark"
                    >
                        <h4
                            class="text-lg font-bold mb-3 flex items-center justify-between text-white"
                        >
                            What is the "Pine Script" editor?
                            <span
                                class="material-symbols-outlined text-gray-500 notranslate"
                                translate="no">expand_more</span
                            >
                        </h4>
                        <p class="text-gray-400 text-sm">
                            Pine Script is a powerful domain-specific language
                            used to create custom indicators and backtest
                            trading strategies directly on our charting
                            platform.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Kontakt / Enterprise Section -->
        <section
            class="py-24 border-t border-border-dark relative overflow-hidden bg-background-dark"
        >
            <div
                class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-primary/5 blur-[100px] rounded-full pointer-events-none"
            >
            </div>
            <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                <div
                    class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center"
                >
                    <div>
                        <h2
                            class="text-3xl font-black mb-6 sm:text-4xl text-white"
                        >
                            Have questions about our <span class="text-primary"
                                >enterprise solutions?</span
                            >
                        </h2>
                        <p class="text-gray-400 text-lg mb-8 leading-relaxed">
                            Our team is here to help you find the perfect plan
                            for your trading needs. Send us a message and we'll
                            get back to you within 24 hours.
                        </p>
                        <div class="space-y-6">
                            <div class="flex items-center gap-4">
                                <div
                                    class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary notranslate"
                                    translate="no"
                                >
                                    <span class="material-symbols-outlined"
                                        >mail</span
                                    >
                                </div>
                                <div>
                                    <p class="text-sm text-gray-500">
                                        Email us at
                                    </p>
                                    <p class="font-bold text-white">
                                        support@fintechpro.com
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center gap-4">
                                <div
                                    class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary notranslate"
                                    translate="no"
                                >
                                    <span class="material-symbols-outlined"
                                        >chat</span
                                    >
                                </div>
                                <div>
                                    <p class="text-sm text-gray-500">
                                        Live Chat
                                    </p>
                                    <p class="font-bold text-white">
                                        Average response: 5 mins
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="glass-card p-8 sm:p-10">
                        <form action="#" class="space-y-6">
                            <div class="space-y-2">
                                <label
                                    class="text-sm font-semibold text-gray-300"
                                    for="full-name">Full Name</label
                                >
                                <input
                                    class="form-input"
                                    id="full-name"
                                    placeholder="John Doe"
                                    type="text"
                                />
                            </div>
                            <div class="space-y-2">
                                <label
                                    class="text-sm font-semibold text-gray-300"
                                    for="email">Email Address</label
                                >
                                <input
                                    class="form-input"
                                    id="email"
                                    placeholder="john@company.com"
                                    type="email"
                                />
                            </div>
                            <div class="space-y-2">
                                <label
                                    class="text-sm font-semibold text-gray-300"
                                    for="message">Message</label
                                >
                                <textarea
                                    class="form-input min-h-[120px] resize-none"
                                    id="message"
                                    placeholder="How can we help you?"
                                ></textarea>
                            </div>
                            <button
                                class="w-full py-4 rounded-xl bg-primary text-white font-bold hover:bg-primary-hover shadow-lg shadow-primary/20 transition-all transform hover:scale-[1.01] active:scale-95 flex items-center justify-center gap-2 group"
                            >
                                <span>Send Message</span>
                                <span
                                    class="material-symbols-outlined text-xl transition-transform group-hover:translate-x-1 notranslate"
                                    translate="no">send</span
                                >
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>
